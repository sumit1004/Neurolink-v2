PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
# Required in Phase 2 when PostgreSQL-backed features are introduced.
DATABASE_URL=postgresql://username:password@localhost:5432/neurolink
# Reserved for Phase 3 only; never expose this value to the client.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
